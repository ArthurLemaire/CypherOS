    <string name="nm_media_animate">換形象後自動產生動態</string>
    <string name="nm_media_animate_sub">%1$d 段 %2$d 秒的短片，每個狀態一段，姿勢畫完後在背景產生</string>
    <string name="nm_media_clips_title">目前形象的短片：%1$d / %2$d</string>
    <string name="nm_media_clips_sub">待機搖頭、等待時玩水晶球、開心時玩五角星、工作時敲電腦</string>
