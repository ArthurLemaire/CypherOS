    <string name="connect_title">Connect to your OpenMuse</string>
    <string name="connect_body">Run <b>openmuse serve --host 0.0.0.0</b> on your computer and scan the QR code it prints, or type the address.</string>
    <string name="connect_scan">Scan QR code</string>
    <string name="connect_or">or</string>
    <string name="connect_url_hint">http://192.168.1.20:8787/?token=…</string>
