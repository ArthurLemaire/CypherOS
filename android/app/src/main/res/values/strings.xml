    <string name="connect_checking">Connecting…</string>
    <string name="connect_bad_url">That is not a server address. It looks like http://host:8787/?token=…</string>
    <string name="connect_no_token">The address has no token. Use the link openmuse serve prints (it ends in ?token=…).</string>
    <string name="connect_unreachable">Could not reach %1$s. Is the server running, and is this phone on the same network?</string>
    <string name="connect_unauthorized">The server refused the token. Copy the current link from openmuse serve.</string>
    <string name="connect_scan_prompt">Point the camera at the QR code printed by openmuse serve</string>

