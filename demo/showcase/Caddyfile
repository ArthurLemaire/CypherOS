# The showcase's front door. Two names:
#
#   SITE_HOST         the phone in the browser (MobileGym + the nanoMuse app), plus /api/demo/*
#   *.SESSION_DOMAIN  one hostname per visitor session, everything relayed to the gateway
#
# Certificates come from Let's Encrypt on their own: HTTP-01 for the site, DNS-01 through
# Cloudflare for the wildcard (a wildcard cannot be had any other way).

{
	email {$ACME_EMAIL}
}

{$SITE_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/demo/* {
		reverse_proxy gateway:8000
	}

	# MobileGym's companion dataset (app media, theme widgets). Optional; see README.
	handle_path /cdn/* {
		root * /srv/cdn
		header Cache-Control "public, max-age=2592000, immutable"
		file_server
	}

	handle {
		root * /srv/site
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

*.{$SESSION_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
	header -Server
	reverse_proxy gateway:8000
}
