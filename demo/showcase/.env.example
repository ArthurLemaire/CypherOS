# The nanoMuse showcase — copy to .env and fill in. Never commit .env.

# ---- names -----------------------------------------------------------------------------------
# Where the phone lives. DNS: A record → this server.
SITE_HOST=demo.nanomuse.dev
# Sessions live at <id>.<SESSION_DOMAIN>. DNS: A record for *.s.nanomuse.dev → this server.
SESSION_DOMAIN=s.nanomuse.dev
PUBLIC_SCHEME=https
# Let's Encrypt writes to this address about certificates.
ACME_EMAIL=you@example.com
# Cloudflare API token with Zone → DNS → Edit on the zone (for the wildcard certificate).
CLOUDFLARE_API_TOKEN=

# ---- the demo model (our key; visitors may bring their own instead) --------------------------
MAIN_PROVIDER=openai
MAIN_MODEL=deepseek-flash
MAIN_BASE_URL=https://api.deepseek.com
MAIN_API_KEY=
# The model that operates the phone: many small calls, a fast one. Leave empty to use MAIN_*.
GUI_PROVIDER=openai
GUI_MODEL=qwen3.8-27b
GUI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GUI_API_KEY=

# ---- budget ----------------------------------------------------------------------------------
# Per session (a visitor's 30 minutes):
SESSION_LLM_REQUESTS=60
SESSION_LLM_TOKENS=300000
# Per day (Asia/Shanghai), all visitors on the demo key together:
DAILY_LLM_REQUESTS=3000
DAILY_LLM_TOKENS=6000000
# Visitors may use their own key (no budget then). The gateway only forwards to these hosts.
BYOK_ENABLED=1
# BYOK_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,dashscope.aliyuncs.com,...

# ---- sessions --------------------------------------------------------------------------------
SESSION_TTL_S=1800
IDLE_TTL_S=600
MAX_SESSIONS=20
PER_IP_ACTIVE=1
PER_IP_DAILY=6
START_TIMEOUT_S=40

# ---- the containers --------------------------------------------------------------------------
NANOMUSE_IMAGE=ghcr.io/nano-muse/nanomuse:latest
CONTAINER_MEMORY=512m
CONTAINER_CPUS=1
CONTAINER_PIDS=256
# Extra environment for every session, comma separated, e.g. NANOMUSE_SENTINEL_MODE=ask
# SESSION_EXTRA_ENV=

# ---- Caddy build -----------------------------------------------------------------------------
# Which MobileGym to build the phone from (branch or tag).
MOBILEGYM_REF=main
