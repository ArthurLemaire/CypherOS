# Copy to .env and fill in. Never commit real secrets.

# LLM provider (abstracted behind dots.llm)
DOTS_LLM_PROVIDER=openai
DOTS_LLM_MODEL=gpt-4o-mini
DOTS_LLM_API_KEY=sk-...

# Runtime
DOTS_STATE_DIR=.dots
DOTS_LOG_LEVEL=INFO
DOTS_DEFAULT_INTERVAL=15m

# Connectors (optional)
SLACK_BOT_TOKEN=xoxb-...
GMAIL_CREDENTIALS_JSON=./credentials.json
GITHUB_TOKEN=ghp_...
