# Copy to .env (git-ignored). Values are read by config.toml via ${VAR}
# and by docker-compose. Never commit real keys.

# --- model provider keys (reference them from [llm].api_key) -------------------
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- nanoMuse overrides (all optional; take precedence over config.toml) --------
# Path to the TOML config file
# NANOMUSE_CONFIG=config/config.toml
# Where memory, goals, vault, audit log and sessions live (default ~/.nanomuse)
# NANOMUSE_DATA_DIR=~/.nanomuse
# The agent's file sandbox (default: agent.workspace from config, ./workspace)
# NANOMUSE_WORKSPACE=./workspace
# openai | openai_responses
# NANOMUSE_LLM_PROVIDER=openai
# NANOMUSE_LLM_MODEL=deepseek-flash
# NANOMUSE_LLM_BASE_URL=https://api.deepseek.com
# NANOMUSE_LLM_API_KEY=
# native | prompt
# NANOMUSE_LLM_TOOL_MODE=native
# ask | strict | auto
# NANOMUSE_SENTINEL_MODE=ask
# DEBUG | INFO | WARNING
# NANOMUSE_LOG_LEVEL=INFO
# base64 Fernet key for the credential vault (default: file in data dir)
# NANOMUSE_VAULT_KEY=
# App server (`nanomuse serve`): bind address, port, and a fixed access token
# NANOMUSE_SERVER_HOST=0.0.0.0
# NANOMUSE_SERVER_PORT=8787
# NANOMUSE_SERVER_TOKEN=
# set to 1 to run tests marked `live` against the configured model
# NANOMUSE_LIVE=0
