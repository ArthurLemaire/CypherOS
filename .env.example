# Copy to .env (git-ignored). Values are read by config.toml via ${VAR}
# and by docker-compose. Never commit real keys.

# --- model provider keys (reference them from [llm].api_key) -------------------
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- OpenMuse overrides (all optional; take precedence over config.toml) --------
# Path to the TOML config file
# OPENMUSE_CONFIG=config/config.toml
# Where memory, goals, vault, audit log and sessions live (default ~/.openmuse)
# OPENMUSE_DATA_DIR=~/.openmuse
# The agent's file sandbox (default: agent.workspace from config, ./workspace)
# OPENMUSE_WORKSPACE=./workspace
# openai | openai_responses
# OPENMUSE_LLM_PROVIDER=openai
# OPENMUSE_LLM_MODEL=deepseek-flash
# OPENMUSE_LLM_BASE_URL=https://api.deepseek.com
# OPENMUSE_LLM_API_KEY=
# native | prompt
# OPENMUSE_LLM_TOOL_MODE=native
# ask | strict | auto
# OPENMUSE_SENTINEL_MODE=ask
# DEBUG | INFO | WARNING
# OPENMUSE_LOG_LEVEL=INFO
# base64 Fernet key for the credential vault (default: file in data dir)
# OPENMUSE_VAULT_KEY=
# App server (`openmuse serve`): bind address, port, and a fixed access token
# OPENMUSE_SERVER_HOST=0.0.0.0
# OPENMUSE_SERVER_PORT=8787
# OPENMUSE_SERVER_TOKEN=
# set to 1 to run tests marked `live` against the configured model
# OPENMUSE_LIVE=0
